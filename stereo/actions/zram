"""The one zram package action shared by Stereo APTus and the Memory KCM."""
import json
import os
from pathlib import Path
import subprocess
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from common import ACTION, PACKAGE, messages

ENGINE = '/usr/bin/sparky-stereo-problems'
TARGET = 'systemd-zram-generator'
# This fixed-purpose helper has its own polkit authorization. The engine's
# PKEXEC_UID check protects direct invocations of its general-purpose CLI.
ENGINE_ENV = dict(os.environ, PATH='/usr/sbin:/usr/bin:/sbin:/bin')
ENGINE_ENV.pop('PKEXEC_UID', None)


def active():
    return any(line.split()[0] == '/dev/zram0' for line in Path('/proc/swaps').read_text().splitlines()[1:] if line.split())


def systemd_running():
    return Path('/run/systemd/system').is_dir()


def status():
    text = messages()
    query = subprocess.run(['/usr/bin/dpkg-query', '-W', '-f=${db:Status-Status}', TARGET],
                           capture_output=True, text=True)
    if query.returncode not in (0, 1):
        raise RuntimeError(query.stderr.strip())
    installed = query.returncode == 0 and query.stdout == 'installed'
    manual = subprocess.run(['/usr/bin/apt-mark', 'showmanual', TARGET], capture_output=True, text=True)
    if manual.returncode:
        raise RuntimeError(manual.stderr.strip())
    chosen = TARGET in manual.stdout.splitlines()
    running = active()
    problems = subprocess.run([ENGINE, 'list', '--json', PACKAGE], capture_output=True, text=True, env=ENGINE_ENV)
    if problems.returncode:
        raise RuntimeError(problems.stderr.strip())
    records = json.loads(problems.stdout)
    if isinstance(records, dict):
        records = records.get('problems', [])
    for record in records:
        if record.get('unreadable') or not record.get('text', record.get('text_en')):
            raise RuntimeError(str(record))
    errors = '\n\n'.join('\n'.join(filter(None, [record.get('text', record.get('text_en', '')),
                                                  record.get('output', '').strip()])) for record in records)
    return dict(installed=installed, active=running, title=text['title'],
                description=text['description'], button=text['remove' if installed else 'install'],
                state=text['installed' if installed else 'absent'] + ' · ' + text['active' if running else 'inactive'],
                restart=text['restart'] if installed and chosen and not running and not systemd_running() else '', error=errors)


def change(operation):
    """Run the entire transaction under the engine's one failure/repair record."""
    text = messages()
    manager = systemd_running()
    if operation == 'remove':
        if manager:
            # Do not reset the device or remove its provider if swapoff failed.
            subprocess.run(['/usr/bin/systemctl', 'stop', 'dev-zram0.swap'], check=True)
        if active():
            raise RuntimeError(text['active'])
        if manager:
            subprocess.run(['/usr/bin/systemctl', 'stop', 'systemd-zram-setup@zram0.service'], check=True)
    command = ['/usr/bin/apt-get', '-y']
    command += ['--no-remove', 'install', TARGET] if operation == 'install' else ['remove', TARGET]
    subprocess.run(command, check=True, env=dict(ENGINE_ENV, DEBIAN_FRONTEND='noninteractive'))
    if operation == 'install':
        if not manager:
            print(text['restart'])
            return
        # An already installed automatic generator still needs a fresh evaluation
        # after apt marks the person's explicit choice as manual.
        subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=True)
        subprocess.run(['/usr/bin/systemctl', 'start', 'dev-zram0.swap'], check=True)
        # A skipped ExecCondition is successful to systemd, but is not active swap.
        if not active():
            raise RuntimeError(text['inactive'])


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ('status', 'install', 'remove', '--install', '--remove'):
        return 2
    operation = sys.argv[1]
    if operation == 'status':
        print(json.dumps(status(), ensure_ascii=False))
        return 0
    if os.geteuid() != 0:
        print(messages()['authorization'], file=sys.stderr)
        return 1
    if operation.startswith('--'):
        change(operation[2:])
        return 0
    # Fixed program and arguments, no shell, configuration path or package supplied by the caller.
    result = subprocess.run([ENGINE, 'run', '--machine', '--repair', json.dumps([ACTION, operation]),
                             PACKAGE, 'zram', 'LOCAL90', '--', ACTION, '--' + operation], env=ENGINE_ENV)
    return result.returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        print(str(error), file=sys.stderr)
        sys.exit(error.returncode if error.returncode > 0 else 1)
    except (OSError, ValueError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
