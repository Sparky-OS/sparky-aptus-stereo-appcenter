"""Allowlisted edition packages, SlimeVR Flatpak and checked vendor downloads; each entry brings the tools its program needs."""
import hashlib
from fnmatch import fnmatchcase
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from common import BASE, PACKAGE, messages, install_downloads
from catalogue import entries, entry
import tools

ENGINE = '/usr/bin/sparky-stereo-problems'
ACTION = str(BASE / 'actions/entry')
DOWNLOADS = Path('/var/cache') / PACKAGE
ONLY_OURS = Path('/etc/apt/preferences.d/sparky-stereo-only-ours')
ENV = dict(os.environ, PATH='/usr/sbin:/usr/bin:/sbin:/bin', DEBIAN_FRONTEND='noninteractive')
ENV.pop('PKEXEC_UID', None)


def only_ours():
    """Read the installed, generated policy; never maintain a second package list."""
    import apt_pkg
    apt_pkg.init_config()
    native = apt_pkg.config.find('APT::Architecture')
    patterns = set()
    with ONLY_OURS.open() as stream:
        for record in apt_pkg.TagFile(stream):
            if int(record.get('Pin-Priority', '0')) >= 0:
                continue
            for spec in record.get('Package', '').split():
                name, _, arch = spec.partition(':')
                if not arch or arch in ('any', 'native', native):
                    patterns.add(name)
    return patterns


def requires_edition(name, patterns):
    return any(fnmatchcase(name, pattern) for pattern in patterns)


def package_set(row):
    """The entry's package and the packages it brings together with it ("also": Syncthing and its Plasma widget)."""
    return [row['package']] + list(row.get('also', []))


def visible(row, cache, patterns):
    if row['kind'] != 'apt' or requires_edition(row['package'], patterns):
        return True
    for name in package_set(row):
        candidate = cache[name].candidate if name in cache else None
        if not (candidate and candidate.downloadable):
            return False
    return True


def installed(row):
    if row['kind'] == 'store':
        return False
    if row['kind'] == 'appimage':
        import appimage
        return appimage.installed(row)
    if row['kind'] == 'download':
        path = DOWNLOADS / row['filename']
        if not path.is_file():
            return False
        with path.open('rb') as stream:
            return hashlib.file_digest(stream, 'sha256').hexdigest() == row['sha256']
    if row['kind'] == 'flatpak':
        if not Path('/usr/bin/flatpak').exists():
            # flatpak is this entry's tool, installed with it: without it nothing of the entry is installed
            return False
        result = subprocess.run(['/usr/bin/flatpak', 'list', '--system', '--app', '--columns=application'],
                                capture_output=True, text=True, check=True)
        return row['package'] in result.stdout.splitlines()
    result = subprocess.run(['/usr/bin/dpkg-query', '-W', '-f=${db:Status-Status}', row['package']],
                            capture_output=True, text=True)
    if result.returncode not in (0, 1):
        raise RuntimeError(result.stderr.strip())
    return result.returncode == 0 and result.stdout == 'installed'


def new_depcache(cache):
    import apt_pkg
    return apt_pkg.DepCache(cache)


def brought_in(depcache, cache, names, entry):
    """Which of NAMES apt would install or upgrade for ENTRY: marked in apt's dependency cache in memory, then undone. apt's own resolver
    does the work, and a package that cannot be resolved is an error that is said."""
    import apt_pkg
    depcache.init()
    try:
        depcache.mark_install(cache[entry], True, True)
        if depcache.broken_count:
            raise RuntimeError('%s: apt cannot resolve its dependencies' % entry)
        found = []
        for name in names:
            package = cache[name]
            if depcache.marked_install(package) or depcache.marked_upgrade(package) or depcache.marked_downgrade(package):
                found.append(name)
        return found
    finally:
        depcache.init()


def planned_downloads(entry, declared, brought, installed_of):
    """The install-time downloads that installing ENTRY brings: the declaration of every declaring package apt would install or upgrade
    for it (brought), except a package whose installed version declares the same download (installed_of), which keeps its data."""
    found = []
    for name in brought(entry):
        now = declared[name]
        if isinstance(now, Exception):
            raise RuntimeError('%s: %s' % (name, now))
        before = installed_of(name)
        if before and (before['size'], before['source']) == (now['size'], now['source']):
            continue
        found.append({'package': name, 'version': now['version'], 'size': now['size'], 'source': now['source']})
    return found


def announce_setting(reader):
    """Sparky::Install-Downloads::Announce of apt's configuration (metered, always or never): the setting apt's own notice follows."""
    import apt_pkg
    apt_pkg.init_config()
    mode, problem = reader.announce_mode(apt_pkg.config.find(reader.OPTION, ''))
    if problem:
        raise RuntimeError(problem)
    return mode


def downloads_note(cache, installed_now, rows):
    """For each entry that is not installed: the notice about its install-time downloads, or None. NetworkManager is asked once."""
    reader = install_downloads()
    mode = announce_setting(reader)
    notes, state = {}, None
    if mode == 'never':
        return notes
    # which packages declare a download is read once; only the entries that can bring one of them in are resolved (resolving every
    # entry takes minutes, and nothing changes for the rest)
    for row in rows:
        if row['kind'] != 'appimage' or installed_now[row['id']]:
            continue
        if state is None:
            state = reader.metered() if mode == 'metered' else ('no', 'not asked')
        found = [dict(package=row['name'], version=row['version'], size=row['size'], source=row['url'])]
        result = reader.assess(found, mode, 'asked', state)
        if result['announce']:
            notes[row['id']] = {'state': result['state'], 'downloads': result['downloads'], 'text': result['text'][:-1]}
    declared, apt_cache = reader.declaring()
    if not declared:
        return notes
    depcache = new_depcache(apt_cache)
    reach = reader.dependants(apt_cache, declared)
    for row in rows:
        if row['kind'] != 'apt' or installed_now[row['id']] or row['package'] not in cache or row['package'] not in reach:
            continue
        try:
            found = planned_downloads(row['package'], declared,
                                      lambda entry: brought_in(depcache, apt_cache, list(declared), entry),
                                      lambda name: reader.installed_declaration(apt_cache, name))
        except RuntimeError as error:
            # said on the entry, in the person's language; the page and the other entries go on
            notes[row['id']] = {'error': reader.messages()['unchecked'].format(why=error)}
            continue
        if not found:
            continue
        if state is None:
            state = reader.metered() if mode == 'metered' else ('no', 'not asked')
        result = reader.assess(found, mode, 'asked', state)
        if result['announce']:
            notes[row['id']] = {'state': result['state'], 'downloads': result['downloads'], 'text': result['text'][:-1]}
    return notes


def tools_note(rows, installed_now, with_main=False):
    """For each entry of the stereo page that is not installed and needs tools the system lacks: the sentences that say which,
    how many packages and apt's sizes, or why they cannot be installed. One simulation for each set of missing tools."""
    notes, plans = {}, {}
    for row in rows:
        if installed_now[row['id']] or (row['section'] == 'main' and not with_main) or not tools.announced(row):
            continue
        try:
            names = tuple(tools.missing(row))
            if names not in plans:
                plans[names] = tools.plan(row)
            if plans[names]:
                notes[row['id']] = {'text': tools.lines(row, plans[names])}
        except tools.Refused as error:
            notes[row['id']] = {'error': str(error)}
    return notes


def entry_downloads(row):
    """The install-time downloads that installing a package entry brings: the declaration of every package apt would install or upgrade for it
    (apt's own resolver marks them in memory, nothing changes) that declares one, except one whose installed version declares the same
    download. Only those packages' records are read: the pass over every package's record (reader.declaring) takes minutes and is for the
    start page's many entries, not for one entry's own page (measured: no result after 6 minutes in a container with the edition's archives)."""
    import apt_pkg
    reader = install_downloads()
    apt_pkg.init()
    cache = apt_pkg.Cache(None)
    if row['package'] not in cache:
        return []
    policy, depcache, records = apt_pkg.Policy(cache), apt_pkg.DepCache(cache), apt_pkg.PackageRecords(cache)
    depcache.init()
    depcache.mark_install(cache[row['package']], True, True)
    if depcache.broken_count:
        raise RuntimeError('%s: apt cannot resolve its dependencies' % row['package'])
    declared = {}
    for package in cache.packages:
        if not (depcache.marked_install(package) or depcache.marked_upgrade(package)):
            continue
        version = policy.get_candidate_ver(package)
        if version is None or not version.file_list:
            continue
        records.lookup(version.file_list[0])
        text = records.record
        if reader.FIELD_SIZE not in text and reader.FIELD_SOURCE not in text:
            continue
        try:
            wanted = reader.declaration(apt_pkg.TagSection(text))
        except ValueError as error:
            raise RuntimeError('%s: %s' % (package.name, error))
        if wanted:
            wanted['version'] = version.ver_str
            declared[package.name] = wanted
    return planned_downloads(row['package'], declared, lambda name: list(declared),
                             lambda name: reader.installed_declaration(cache, name))


def entry_notes(row):
    """(the sentences of the install-time download said first, whatever the metered setting is; the shared metered notice or an error, as
    downloads_note makes it) for a package entry that is not installed, from one reading of apt's records."""
    reader = install_downloads()
    try:
        found = entry_downloads(row)
        if not found:
            return [], None
        first = reader.assess(found, 'always', 'not-asked', ('no', 'not asked'))['text'][:-1]
        mode = announce_setting(reader)
        if mode == 'never':
            return first, None
        state = reader.metered() if mode == 'metered' else ('no', 'not asked')
        result = reader.assess(found, mode, 'asked', state)
        return first, ({'state': result['state'], 'downloads': result['downloads'], 'text': result['text'][:-1]} if result['announce'] else None)
    except (RuntimeError, ValueError) as error:
        return [], {'error': reader.messages()['unchecked'].format(why=error)}


def status_one(identifier):
    """The state of one entry, with its sizes: what the Info Centre's page asks and what a package entry's page shows (unprivileged,
    nothing changes). For a package entry of a main page that is not installed: the tools and the packages' sizes, the install-time
    download said first, and the metered notice when the setting asks for it."""
    import apt
    row = entry(identifier)
    cache, patterns = apt.Cache(), only_ours()
    now = installed(row)
    shown = visible(row, cache, patterns)
    needs = tools_note([row], {row['id']: now}, with_main=row['kind'] == 'apt') if shown else {}
    note, declared = None, []
    if shown and row['kind'] == 'apt' and row['section'] == 'main' and not now:
        declared, note = entry_notes(row)
    return dict(installed=now, visible=shown, tools=needs.get(row['id']), download=note, declared=declared)


def status():
    import apt
    cache, patterns = apt.Cache(), only_ours()
    problems = subprocess.run([ENGINE, 'list', '--json', PACKAGE], capture_output=True,
                              text=True, check=True, env=ENV)
    records = json.loads(problems.stdout)
    if isinstance(records, dict):
        records = records.get('problems', [])
    errors = {}
    for record in records:
        if record.get('unreadable') or not record.get('text', record.get('text_en')):
            raise RuntimeError(str(record))
        errors[record['key']] = '\n'.join(filter(None, [record.get('text', record.get('text_en')), record.get('output')]))
    rows = entries()
    present = {row['id']: installed(row) for row in rows}
    shown = [row for row in rows if visible(row, cache, patterns)]
    notes = downloads_note(cache, present, shown)
    needs = tools_note(shown, present)
    return {row['id']: dict(installed=present[row['id']], error=errors.get(row['id'], ''),
                           visible=visible(row, cache, patterns), download=notes.get(row['id']),
                           tools=needs.get(row['id'])) for row in rows}


def apt_change(row, operation, found=None):
    name = row['package']
    if operation == 'install':
        import apt
        cache = apt.Cache()
        candidate = cache[name].candidate if name in cache else None
        # Enforce the edition's generated policy even if another pin changes APT's candidate.
        if requires_edition(name, only_ours()) and (candidate is None or not any(
                origin.origin == 'Sparky Stereo OS' and origin.trusted for origin in candidate.origins)):
            raise RuntimeError(messages()['edition_missing'].format(name=name))
        command = ['/usr/bin/apt-get', '-y', '--no-remove', '--no-allow-unauthenticated',
                   'install', name + '=' + candidate.version if candidate else name, *row.get('also', [])]
    else:
        command = ['/usr/bin/apt-get', '-y', 'remove', *package_set(row)]
    if row.get('model_profile') and operation=='install':
        subprocess.run(['/usr/lib/sparky-stereo-apt/model-install-gui',name+'='+candidate.version],check=True,env=ENV)
        return
    if row.get('sizes'):
        # no sentence depends on apt's own wording, which follows the session's language: a lock that is held is found by trying
        # it, and a failure of the download-only step is the network (the plan was already made, so the package is offered)
        held(row)
        run_said(row, command[:1] + ['--download-only'] + command[1:], 'apt_network')
        try:
            run_said(row, command, 'apt_failed')
        except RuntimeError as error:
            # a package that fetches its program in its own setup (sparky-pjeoffice) keeps the reason in the one engine: said here too
            raise RuntimeError('\n'.join(filter(None, [str(error), kept_problem(row)])))
    else:
        subprocess.run(command, check=True, env=ENV)


def kept_problem(row):
    """The sentence the engine keeps for the entry's package after a failed installation, in the person's language, or nothing. Only a
    package that keeps its own problem says so in its row ("problem_key"): sparky-pjeoffice fetches its program in its own setup."""
    if not row.get('problem_key'):
        return ''
    try:
        result = subprocess.run([ENGINE, 'text', '--machine', row['package'], row['problem_key']], capture_output=True, text=True, env=ENV)
    except OSError:
        return ''   # the sentence is an addition to apt's own failure, which is raised either way
    return result.stdout.strip() if result.returncode == 0 else ''


def lock_files():
    """The locks apt and dpkg take, where apt's own configuration puts them (dpkg's frontend and database beside its status file,
    apt's lists and archives): a system with other directories is tried in its own."""
    import apt_pkg
    apt_pkg.init_config()
    state = os.path.dirname(apt_pkg.config.find_file('Dir::State::status'))
    return (os.path.join(state, 'lock-frontend'), os.path.join(state, 'lock'),
            os.path.join(apt_pkg.config.find_dir('Dir::State::lists'), 'lock'),
            os.path.join(apt_pkg.config.find_dir('Dir::Cache::archives'), 'lock'))


def held(row, locks=None):
    """Another program holds apt's or dpkg's lock: tried the way apt tries it (a non-blocking fcntl lock), then let go."""
    import fcntl
    for path in (lock_files() if locks is None else locks):
        try:
            stream = open(path, 'a+')
        except FileNotFoundError:
            continue
        try:
            fcntl.lockf(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise RuntimeError(messages()['apt_busy'].format(name=row['name']))
        finally:
            stream.close()


def run_said(row, command, failure):
    """apt's own lines go through as they come, in the person's language. A failure is the sentence FAILURE names (apt_network for
    the download-only step, apt_failed with apt's exit status for the install), never a guess from apt's words."""
    process = subprocess.Popen(command, env=ENV, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors='replace')
    for line in process.stdout:
        print(line, end='', flush=True)
    if process.wait() == 0:
        return
    raise RuntimeError(messages()[failure].format(name=row['name'], code=process.returncode))


def flatpak_change(row, operation, found=None):
    if operation == 'install':
        tools.ensure(row, found)
        remotes = subprocess.run(['/usr/bin/flatpak', 'remotes', '--system', '--columns=name'],
                                 capture_output=True, text=True, check=True).stdout.splitlines()
        if 'flathub' not in remotes:
            raise RuntimeError(messages()['flathub_missing'])
        command = ['/usr/bin/flatpak', 'install', '--system', '--noninteractive', 'flathub', row['package']]
    else:
        command = ['/usr/bin/flatpak', 'uninstall', '--system', '--noninteractive', row['package']]
    subprocess.run(command, check=True, env=ENV)


def download(row, operation, found=None):
    path = DOWNLOADS / row['filename']
    if operation == 'remove':
        path.unlink(missing_ok=True)
        return
    DOWNLOADS.mkdir(mode=0o755, parents=True, exist_ok=True)
    # Download to a private file. The public path appears only after verification.
    with tempfile.TemporaryDirectory(prefix='.download-', dir=DOWNLOADS) as directory:
        candidate = Path(directory) / 'payload'
        subprocess.run(['/usr/bin/curl', '--fail', '--location', '--proto', '=https',
                        '--proto-redir', '=https', '--connect-timeout', '30', '--max-time', '600',
                        '--output', str(candidate), row['url']], check=True)
        with candidate.open('rb') as stream:
            digest = hashlib.file_digest(stream, 'sha256').hexdigest()
        if digest != row['sha256']:
            raise RuntimeError(messages()['checksum_failed'])
        candidate.chmod(0o644)
        candidate.replace(path)
    print(messages()['download_ready'].format(path=path))


def appimage_change(row, operation, found=None):
    import appimage
    appimage.change(row, operation, lambda: tools.ensure(row, found))


def announce(row, found):
    """Said before anything is fetched: the tools the entry brings with apt's sizes, then, on a metered connection (or when
    NetworkManager cannot be read), the install-time download notice for the program's own download and the tools' together."""
    for line in tools.lines(row, found):
        print(line, flush=True)
    downloads = []
    if row['kind'] == 'appimage':
        downloads.append(dict(package=row['name'], version=row['version'], size=row['size'], source=row['url']))
    if found:
        downloads.append(tools.download(found))
    if downloads:
        reader = install_downloads()
        for line in reader.assess(downloads, announce_setting(reader), 'unattended')['text']:
            print(line, flush=True)


def needed_elsewhere(row):
    """The tools that another installed entry declares: removing ROW leaves their marks alone."""
    return {name for other in entries() if other['id'] != row['id'] and tools.declared(other) and installed(other)
            for name in tools.declared(other)}


def change(row, operation):
    found = None
    if operation == 'install':
        # refused here, with apt's reason, when a tool cannot be installed: before any download and any change
        found = tools.plan(row)
        announce(row, found)
    try:
        {'apt': apt_change, 'flatpak': flatpak_change, 'download': download, 'appimage': appimage_change}[row['kind']](row, operation, found)
        if installed(row) != (operation == 'install'):
            raise RuntimeError(row['name'] + ': ' + messages()['installed' if installed(row) else 'absent'])
    except Exception:
        # the tools arrived and the entry did not: they stay, and apt's own rule decides, as after a removal
        if operation == 'install' and not installed(row):
            try:
                tools.release(row, needed_elsewhere(row))
            except (OSError, subprocess.CalledProcessError) as second:
                print(str(second), file=sys.stderr)
        raise
    if operation == 'remove':
        tools.release(row, needed_elsewhere(row))


def main():
    if sys.argv[1:] == ['status']:
        print(json.dumps(status(), ensure_ascii=False))
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == 'status':
        try:
            print(json.dumps(status_one(sys.argv[2]), ensure_ascii=False))
        except StopIteration:
            return 2
        return 0
    if len(sys.argv) != 3 or sys.argv[2] not in ('install', 'remove', 'repair', '--install', '--remove', 'reinstall'):
        return 2
    try:
        row = entry(sys.argv[1])
    except StopIteration:
        return 2
    if row['kind'] == 'store':
        print(messages()['store_unchangeable'].format(name=row['name'], vendor=row['vendor']), file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print(messages()['entry_authorization'], file=sys.stderr)
        return 1
    operation = sys.argv[2]
    if operation == 'reinstall':
        operation = 'install'
    if operation == 'repair':
        return subprocess.run([ENGINE, 'repair', '--machine', PACKAGE, row['id']], env=ENV).returncode
    if operation.startswith('--'):
        change(row, operation[2:])
        return 0
    command = [ACTION, row['id'], operation]
    return subprocess.run([ENGINE, 'run', '--machine', '--repair', json.dumps(command),
                           PACKAGE, row['id'], 'LOCAL91', '--', ACTION, row['id'], '--' + operation], env=ENV).returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        print(str(error), file=sys.stderr)
        sys.exit(error.returncode if error.returncode > 0 else 1)
    except (OSError, ValueError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
