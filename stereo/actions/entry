"""Allowlisted edition packages, SlimeVR Flatpak and checked vendor downloads."""
import hashlib
from fnmatch import fnmatchcase
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from common import BASE, PACKAGE, messages, install_downloads
from catalogue import entries, entry

ENGINE = '/usr/bin/sparky-stereo-problems'
ACTION = str(BASE / 'actions/entry')
DOWNLOADS = Path('/var/cache') / PACKAGE
ONLY_OURS = Path('/etc/apt/preferences.d/sparky-stereo-only-ours')
ENV = dict(os.environ, PATH='/usr/sbin:/usr/bin:/sbin:/bin', DEBIAN_FRONTEND='noninteractive')
ENV.pop('PKEXEC_UID', None)


def only_ours():
    """Read the installed, generated policy; never maintain a second package list."""
    import apt_pkg
    apt_pkg.init_config()
    native = apt_pkg.config.find('APT::Architecture')
    patterns = set()
    with ONLY_OURS.open() as stream:
        for record in apt_pkg.TagFile(stream):
            if int(record.get('Pin-Priority', '0')) >= 0:
                continue
            for spec in record.get('Package', '').split():
                name, _, arch = spec.partition(':')
                if not arch or arch in ('any', 'native', native):
                    patterns.add(name)
    return patterns


def requires_edition(name, patterns):
    return any(fnmatchcase(name, pattern) for pattern in patterns)


def visible(row, cache, patterns):
    if row['kind'] != 'apt' or requires_edition(row['package'], patterns):
        return True
    candidate = cache[row['package']].candidate if row['package'] in cache else None
    return bool(candidate and candidate.downloadable)


def installed(row):
    if row['kind'] == 'download':
        path = DOWNLOADS / row['filename']
        if not path.is_file():
            return False
        with path.open('rb') as stream:
            return hashlib.file_digest(stream, 'sha256').hexdigest() == row['sha256']
    if row['kind'] == 'flatpak':
        result = subprocess.run(['/usr/bin/flatpak', 'list', '--system', '--app', '--columns=application'],
                                capture_output=True, text=True, check=True)
        return row['package'] in result.stdout.splitlines()
    result = subprocess.run(['/usr/bin/dpkg-query', '-W', '-f=${db:Status-Status}', row['package']],
                            capture_output=True, text=True)
    if result.returncode not in (0, 1):
        raise RuntimeError(result.stderr.strip())
    return result.returncode == 0 and result.stdout == 'installed'


def new_depcache(cache):
    import apt_pkg
    return apt_pkg.DepCache(cache)


def brought_in(depcache, cache, names, entry):
    """Which of NAMES apt would install or upgrade for ENTRY: marked in apt's dependency cache in memory, then undone. apt's own resolver
    does the work, and a package that cannot be resolved is an error that is said."""
    import apt_pkg
    depcache.init()
    try:
        depcache.mark_install(cache[entry], True, True)
        if depcache.broken_count:
            raise RuntimeError('%s: apt cannot resolve its dependencies' % entry)
        found = []
        for name in names:
            package = cache[name]
            if depcache.marked_install(package) or depcache.marked_upgrade(package) or depcache.marked_downgrade(package):
                found.append(name)
        return found
    finally:
        depcache.init()


def planned_downloads(entry, declared, brought, installed_of):
    """The install-time downloads that installing ENTRY brings: the declaration of every declaring package apt would install or upgrade
    for it (brought), except a package whose installed version declares the same download (installed_of), which keeps its data."""
    found = []
    for name in brought(entry):
        now = declared[name]
        if isinstance(now, Exception):
            raise RuntimeError('%s: %s' % (name, now))
        before = installed_of(name)
        if before and (before['size'], before['source']) == (now['size'], now['source']):
            continue
        found.append({'package': name, 'version': now['version'], 'size': now['size'], 'source': now['source']})
    return found


def announce_setting(reader):
    """Sparky::Install-Downloads::Announce of apt's configuration (metered, always or never): the setting apt's own notice follows."""
    import apt_pkg
    apt_pkg.init_config()
    mode, problem = reader.announce_mode(apt_pkg.config.find(reader.OPTION, ''))
    if problem:
        raise RuntimeError(problem)
    return mode


def downloads_note(cache, installed_now, rows):
    """For each entry that is not installed: the notice about its install-time downloads, or None. NetworkManager is asked once."""
    reader = install_downloads()
    mode = announce_setting(reader)
    notes, state = {}, None
    if mode == 'never':
        return notes
    # which packages declare a download is read once; only the entries that can bring one of them in are resolved (resolving every
    # entry takes minutes, and nothing changes for the rest)
    declared, apt_cache = reader.declaring()
    if not declared:
        return notes
    depcache = new_depcache(apt_cache)
    reach = reader.dependants(apt_cache, declared)
    for row in rows:
        if row['kind'] != 'apt' or installed_now[row['id']] or row['package'] not in cache or row['package'] not in reach:
            continue
        try:
            found = planned_downloads(row['package'], declared,
                                      lambda entry: brought_in(depcache, apt_cache, list(declared), entry),
                                      lambda name: reader.installed_declaration(apt_cache, name))
        except RuntimeError as error:
            # said on the entry, in the person's language; the page and the other entries go on
            notes[row['id']] = {'error': reader.messages()['unchecked'].format(why=error)}
            continue
        if not found:
            continue
        if state is None:
            state = reader.metered() if mode == 'metered' else ('no', 'not asked')
        result = reader.assess(found, mode, 'asked', state)
        if result['announce']:
            notes[row['id']] = {'state': result['state'], 'downloads': result['downloads'], 'text': result['text'][:-1]}
    return notes


def status():
    import apt
    cache, patterns = apt.Cache(), only_ours()
    problems = subprocess.run([ENGINE, 'list', '--json', PACKAGE], capture_output=True,
                              text=True, check=True, env=ENV)
    records = json.loads(problems.stdout)
    if isinstance(records, dict):
        records = records.get('problems', [])
    errors = {}
    for record in records:
        if record.get('unreadable') or not record.get('text', record.get('text_en')):
            raise RuntimeError(str(record))
        errors[record['key']] = '\n'.join(filter(None, [record.get('text', record.get('text_en')), record.get('output')]))
    rows = entries()
    present = {row['id']: installed(row) for row in rows}
    shown = [row for row in rows if visible(row, cache, patterns)]
    notes = downloads_note(cache, present, shown)
    return {row['id']: dict(installed=present[row['id']], error=errors.get(row['id'], ''),
                           visible=visible(row, cache, patterns), download=notes.get(row['id'])) for row in rows}


def apt_change(row, operation):
    name = row['package']
    if operation == 'install':
        import apt
        cache = apt.Cache()
        candidate = cache[name].candidate if name in cache else None
        # Enforce the edition's generated policy even if another pin changes APT's candidate.
        if requires_edition(name, only_ours()) and (candidate is None or not any(
                origin.origin == 'Sparky Stereo OS' and origin.trusted for origin in candidate.origins)):
            raise RuntimeError(messages()['edition_missing'].format(name=name))
        command = ['/usr/bin/apt-get', '-y', '--no-remove', '--no-allow-unauthenticated',
                   'install', name + '=' + candidate.version if candidate else name]
    else:
        command = ['/usr/bin/apt-get', '-y', 'remove', name]
    subprocess.run(command, check=True, env=ENV)


def flatpak_change(row, operation):
    if operation == 'install':
        remotes = subprocess.run(['/usr/bin/flatpak', 'remotes', '--system', '--columns=name'],
                                 capture_output=True, text=True, check=True).stdout.splitlines()
        if 'flathub' not in remotes:
            raise RuntimeError(messages()['flathub_missing'])
        command = ['/usr/bin/flatpak', 'install', '--system', '--noninteractive', 'flathub', row['package']]
    else:
        command = ['/usr/bin/flatpak', 'uninstall', '--system', '--noninteractive', row['package']]
    subprocess.run(command, check=True, env=ENV)


def download(row, operation):
    path = DOWNLOADS / row['filename']
    if operation == 'remove':
        path.unlink(missing_ok=True)
        return
    DOWNLOADS.mkdir(mode=0o755, parents=True, exist_ok=True)
    # Download to a private file. The public path appears only after verification.
    with tempfile.TemporaryDirectory(prefix='.download-', dir=DOWNLOADS) as directory:
        candidate = Path(directory) / 'payload'
        subprocess.run(['/usr/bin/curl', '--fail', '--location', '--proto', '=https',
                        '--proto-redir', '=https', '--connect-timeout', '30', '--max-time', '600',
                        '--output', str(candidate), row['url']], check=True)
        with candidate.open('rb') as stream:
            digest = hashlib.file_digest(stream, 'sha256').hexdigest()
        if digest != row['sha256']:
            raise RuntimeError(messages()['checksum_failed'])
        candidate.chmod(0o644)
        candidate.replace(path)
    print(messages()['download_ready'].format(path=path))


def change(row, operation):
    {'apt': apt_change, 'flatpak': flatpak_change, 'download': download}[row['kind']](row, operation)
    if installed(row) != (operation == 'install'):
        raise RuntimeError(row['name'] + ': ' + messages()['installed' if installed(row) else 'absent'])


def main():
    if sys.argv[1:] == ['status']:
        print(json.dumps(status(), ensure_ascii=False))
        return 0
    if len(sys.argv) != 3 or sys.argv[2] not in ('install', 'remove', 'repair', '--install', '--remove'):
        return 2
    try:
        row = entry(sys.argv[1])
    except StopIteration:
        return 2
    if os.geteuid() != 0:
        print(messages()['entry_authorization'], file=sys.stderr)
        return 1
    operation = sys.argv[2]
    if operation == 'repair':
        return subprocess.run([ENGINE, 'repair', '--machine', PACKAGE, row['id']], env=ENV).returncode
    if operation.startswith('--'):
        change(row, operation[2:])
        return 0
    command = [ACTION, row['id'], operation]
    return subprocess.run([ENGINE, 'run', '--machine', '--repair', json.dumps(command),
                           PACKAGE, row['id'], 'LOCAL91', '--', ACTION, row['id'], '--' + operation], env=ENV).returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        print(str(error), file=sys.stderr)
        sys.exit(error.returncode if error.returncode > 0 else 1)
    except (OSError, ValueError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
