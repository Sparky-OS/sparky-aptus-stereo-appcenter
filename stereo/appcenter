import html
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from common import ACTION, BASE, messages, language
from catalogue import entries


def render():
    text = messages()
    result = subprocess.run([ACTION, 'status'], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip())
    state = json.loads(result.stdout)
    result = subprocess.run([str(BASE / 'actions/entry'), 'status'], capture_output=True, text=True, check=True)
    states = json.loads(result.stdout)
    original = Path('/usr/lib/sparky-aptus-appcenter')
    page = (original / 'index.html').read_text()
    # Read his category links at runtime, so additions and translated names stay his.
    categories = re.findall(r'<a href="([^"/]+\.html)" class="button">(.*?)</a>', page, re.S)
    links = ''.join(f'<a class="category" href="{(original / target).as_uri()}">{label}</a>' for target, label in categories)
    e = html.escape
    operation = 'remove' if state['installed'] else 'install'
    sections = []
    for group in ('emulation', 'media', 'vr'):
        cards = []
        for row in entries():
            if row['section'] != group:
                continue
            current = states[row['id']]
            if not current['visible']:
                continue
            selected = current['installed']
            action = 'remove' if selected else 'install'
            button = text['remove' if selected else 'install']
            indicator = text['installed' if selected else 'absent']
            note = ''
            if current['error']:
                note = f'<a class="action" href="aptus://stereo_entry_{row["id"]}_repair">{e(text["repair"])}</a>' 
            if row['kind'] == 'download':
                button = text['remove' if selected else 'download']
                indicator = text['downloaded'] if selected else '—'
                note += f'<p><a href="{e(row["documentation"])}">{e(text["download_note"])}</a></p>'
                if selected:
                    note += f'<p>{e("/var/cache/sparky-aptus-stereo-appcenter/" + row["filename"])}</p>'
            if current.get('download') and current['download'].get('error'):
                note += f'<p class="error">{e(current["download"]["error"])}</p>'
            elif current.get('download'):
                # the install-time download this entry brings, with its size and source, before the person installs (apt shows the same words)
                lines = ''.join(f'<span>{e(line)}</span><br>' for line in current['download']['text'])
                note += f'<p class="download">{lines}</p>'
            cards.append(f'<article id="entry-{row["id"]}"><h3>{e(row["name"])}</h3>'
                         f'<p class="state">{e(indicator)}</p>{note}'
                         f'<p class="error">{e(current["error"])}</p>'
                         f'<a class="action" href="aptus://stereo_entry_{row["id"]}_{action}">{e(button)}</a></article>')
        if group == 'media':
            cards.append(f'<article id="codesys"><h3>CODESYS 4</h3><p>{e(text["codesys_note"])}</p>'
                         '<a class="action" href="https://store.codesys.com/en/codesys-4.html">CODESYS Store</a></article>')
        if group == 'vr':
            cards.append('<article><h3>SteamVR</h3><a href="https://store.steampowered.com/app/250820/SteamVR/">SteamVR</a></article>')
        sections.append(f'<section id="stereo-{group}"><details><summary><h2>{e(text[group])}</h2></summary>'
                        f'<div class="entries">{"".join(cards)}</div></details></section>')
    sections.append(f'<section id="stereo-drivers"><h2>{e(text["drivers"])}</h2>'
                    f'<p>NVIDIA · AMD</p><a class="action" href="aptus://stereo_hardware">{e(text["hardware"])}</a></section>')
    return f'''<!doctype html><html lang="{language()}"><meta charset="utf-8">
<base href="{original.as_uri()}/"><title>Stereo APTus</title>
<script src="js/lang.js"></script>
<style>body{{font:18px sans-serif;max-width:900px;margin:32px auto;padding:0 20px;color:#202428;background:#f5f7fa}}section{{background:white;border:1px solid #ccd5df;border-radius:8px;padding:24px;margin-bottom:24px}}a{{color:#124e92}}.category{{display:inline-block;padding:14px;min-width:220px}}.action{{display:inline-block;background:#124e92;color:white;padding:12px 26px;border-radius:5px}}.error{{white-space:pre-wrap;color:#9a1818}}.download{{color:#5a3d00;background:#fff4d6;border-radius:5px;padding:8px}}h1{{font-size:28px}}h2{{font-size:22px;margin:0}}summary{{cursor:pointer}}summary h2{{display:inline}}.entries{{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px}}article{{border-top:1px solid #ccd5df;padding:12px;overflow-wrap:anywhere}}article h3{{margin:4px 0}}.state{{color:#37566c}}</style>
<h1>Stereo APTus</h1>{"".join(sections)}<section id="stereo-system"><h2>{e(text['system'])}</h2>
<h3>{e(state['title'])}</h3><p>{e(state['description'])}</p><p id="zram-state">{e(state['state'])}</p>
<p>{e(state['restart'])}</p><p class="error">{e(state['error'])}</p>
<a class="action" href="aptus://stereo_zram_{operation}">{e(state['button'])}</a></section>
<section id="pawel-categories"><h2>{e(text['categories'])}</h2>{links}</section>
<footer>{e(text['credit'])}</footer></html>'''.replace('\n+', '\n')


if __name__ == '__main__':
    try:
        page = render()
        if sys.argv[1:] == ['--render']:
            print(page)
            sys.exit(0)
        with tempfile.TemporaryDirectory(prefix='sparky-aptus-stereo-') as directory:
            path = Path(directory) / 'index.html'
            path.write_text(page)
            # Paweł's pages select translations through YAD's user-agent.
            code = {'pt_BR': 'pt', 'pt_PT': 'pt', 'es_AR': 'es', 'es_ES': 'es'}.get(language(), language())
            if not (Path('/usr/lib/sparky-aptus-appcenter/lang/main') / (code + '.js')).exists():
                code = 'en'
            subprocess.run(['yad', '--html', '--browser', '--width=1050', '--height=780',
                            '--title=Stereo APTus', '--uri=' + path.as_uri(),
                            '--user-agent=' + code, '--uri-handler=' + str(BASE / 'handler')])
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        subprocess.run(['yad', '--error', '--title=Stereo APTus', '--text=' + str(error)])
        sys.exit(1)
