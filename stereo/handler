import os
from pathlib import Path
import signal
import subprocess
import sys
from common import ACTION
from catalogue import route

uri = sys.argv[1] if len(sys.argv) > 1 else ''
operation = {'aptus://stereo_zram_install': 'install',
             'aptus://stereo_zram_remove': 'remove'}.get(uri)
command = [ACTION, operation] if operation else route(uri)
if uri == 'aptus://stereo_hardware':
    command = ['/usr/bin/sparky-stereo-hardware']
if command:
    if os.geteuid() != 0:
        command.insert(0, '/usr/bin/pkexec')
    subprocess.run(command)
    if os.environ.get('YAD_PID', '').isdigit():
        os.kill(int(os.environ['YAD_PID']), signal.SIGUSR1)
    subprocess.Popen(['/usr/bin/sparky-aptus-stereo-appcenter'])
    sys.exit(1)  # YAD must not navigate to the handled URI.

# Paweł's protocol and its arguments stay his. His scripts use relative paths.
os.chdir('/usr/lib/sparky-aptus-appcenter')
os.execv('./handler', ['./handler', *sys.argv[1:]])
