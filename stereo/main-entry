"""Entry page shared by the main protocol handler and its command-line backend."""
import sys
import subprocess
from catalogue import entry
import mainpages

if len(sys.argv) not in (2, 3) or (len(sys.argv) == 3 and sys.argv[2] != '--render'):
    sys.exit(2)
try:
    row=entry(sys.argv[1])
except StopIteration:
    sys.exit(2)
if sys.argv[2:] == ['--render']:
    print(mainpages.render(row))
else:
    try:
        mainpages.handle(row, None)
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        subprocess.run(['yad', '--error', '--title=APTus AppCenter', '--text=' + str(error)])
        sys.exit(1)
